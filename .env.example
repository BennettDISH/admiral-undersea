# Admiral Undersea — environment variables
# Copy to server/.env for local dev; set these in Railway for deploy.

# --- Required ---
# Postgres connection (schema auto-applies on boot). Railway provides this.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Signs session tokens. REQUIRED in production — the server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string
# Enables the JWT_SECRET guard + Express production mode.
NODE_ENV=production

# --- Optional ---
# Port (Railway provides this; defaults to 5000).
PORT=5000
# Another origin allowed to call the API and open sockets (CORS / socket.io), only needed
# when the client is hosted somewhere else. The built client is served by this server, and
# same-origin needs no CORS, so it can stay unset on Railway. Unset in development, the Vite
# dev server (http://localhost:5173) is allowed.
# FRONTEND_URL=https://your-admiral-client.example

# --- Central SSO (optional; local username/password works without these) ---
# Server-side confidential OAuth client (same pattern as the CMS). All three enable the
# "Sign in with SSO" button. No build-time VITE vars are needed — the client_id/secret
# never reach the browser.
AUTH_SERVICE_URL=https://your-auth-service-domain
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
# Optional: override the origin used to build the OAuth redirect_uri.
# APP_BASE_URL=https://your-admiral-domain.up.railway.app

# The auth-service must have THIS app registered with redirect_uri:
#   <this app's public origin>/auth/callback

# --- Site admins (optional) ---
# Admin: /admin, Waypoint id 1 only. Comma-separated central (Waypoint) account ids that may
# open the look-only /admin page. Unset or empty means nobody can: the admin views fail closed.
# ADMIN_CENTRAL_USER_IDS=1
